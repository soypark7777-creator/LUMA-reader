# ══════════════════════════════════════════════
#  LUMA 환경변수 템플릿
#  cp .env.example .env  →  값 입력  →  실행
#  ⚠️  .env 는 절대 GitHub에 올리지 마세요!
# ══════════════════════════════════════════════

# ── 앱 기본 ────────────────────────────────────
APP_NAME=LUMA
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
HOST=0.0.0.0
SECRET_KEY=luma-super-secret-change-in-production

# ── Gemini AI ──────────────────────────────────
# 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyC_mLTXbHf1pmMMp81X35pMWgiGFUpPHio
GEMINI_MODEL=gemini-1.5-flash

# ── Firebase ───────────────────────────────────
# Firebase Console → 프로젝트 설정 → 서비스 계정 → JSON 다운로드
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── Google Maps ────────────────────────────────
# console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
GOOGLE_MAPS_API_KEY=AIzaSyC6s5gUpuPAIQaRpVhbYkYyBB_Fb5h-xy8


# ── Google Books ───────────────────────────────
GOOGLE_BOOKS_API_KEY=여기에_Books_키_입력

# ── Naver Book Search API ─────────────────────
# 발급: https://developers.naver.com → Application → 애플리케이션 등록 → 검색 API
NAVER_CLIENT_ID=BZDr2udKWEAVw2BCT1C8
NAVER_CLIENT_SECRET=lENVr8MRam


# ── YouTube Data API v3 ───────────────────────
YOUTUBE_API_KEY=AIzaSyA0g_Y3ApajUT_U04aeYSNChK4MLNK-aQg
# ── 기능 플래그 (true/false) ──────────────────
ENABLE_AI=true
ENABLE_OCR=true
ENABLE_MAPS=true
